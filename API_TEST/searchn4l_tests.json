{
  "description": "SearchN4L API Test Configuration",
  "version": "1.0.0",
  "api_endpoint": "/searchN4L",
  "test_categories": [
    {
      "id": "basic_searches",
      "name": "Basic Search Tests",
      "description": "Test fundamental search functionality",
      "icon": "📁",
      "tests": [
        {
          "id": "basic_word_search",
          "name": "Basic word search",
          "description": "Search for a simple word",
          "parameters": {
            "name": "test"
          },
          "expected_status": 200,
          "validation": {
            "response_type": "application/json",
            "contains_text": true,
            "min_response_size": 100
          }
        },
        {
          "id": "concept_search",
          "name": "Concept search",
          "description": "Search for a multi-word concept",
          "parameters": {
            "name": "sperm whale"
          },
          "expected_status": 200,
          "validation": {
            "response_type": "application/json",
            "contains_text": true,
            "min_response_size": 100
          }
        },
        {
          "id": "chapter_specific_search",
          "name": "Chapter-specific search",
          "description": "Search within a specific chapter",
          "parameters": {
            "name": "kubernetes \\\\chapter \"Kubernetes notes\""
          },
          "expected_status": 200,
          "validation": {
            "response_type": "application/json",
            "contains_text": true,
            "min_response_size": 100
          }
        },
        {
          "id": "empty_search_reminders",
          "name": "Empty search (reminders)",
          "description": "Empty search should default to reminders",
          "parameters": {
            "name": ""
          },
          "expected_status": 200,
          "validation": {
            "response_type": "application/json",
            "contains_text": true,
            "min_response_size": 50
          }
        },
        {
