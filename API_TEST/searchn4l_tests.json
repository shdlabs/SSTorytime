          },
          "expected_status": 200,
          "validation": {
            "response_type": "application/json",
            "contains_text": true,
            "min_response_size": 100
          }
        },
        {
          "id": "direct_node_access",
          "name": "Direct node access",
          "description": "Access specific node by pointer",
          "parameters": {
            "name": "",
            "nclass": "5",
            "ncptr": "1957",
            "chapcontext": ""
