- flag - Command-line flag parsing

+ golang
+ stdlib
+ docs-analysis
+ flag

 "Discover Packages Standard library flag"
      " (contain) "import path"
           " (contain) "Discover Packages Standard library flag"
      " (contain) documentation
           " (contain) "Package flag implements command-line flag parsing."
           " (contain) "Define flags using flag.String, Bool, Int, etc."
      " (contain) functions
           " (contain) Arg
                " (contain) signature
                     " (contain) "func Arg(i int) string"
                " (contain) description
                     " (contain) "Arg returns the i'th command-line argument. Arg(0) is the first remaining argument after flags have been processed. Arg returns an empty string if the requested element does not exist."
           " (contain) Args
                " (contain) signature
                     " (contain) "func Args() []string"
                " (contain) description
                     " (contain) "Args returns the non-flag command-line arguments."
           " (contain) Bool
                " (contain) signature
                     " (contain) "func Bool(name string, value bool, usage string) *bool"
                " (contain) description
                     " (contain) "Bool defines a bool flag with specified name, default value, and usage string. The return value is the address of a bool variable that stores the value of the flag."
           " (contain) BoolFunc
                " (contain) signature
                     " (contain) "func BoolFunc(name, usage string, fn func(string) error)"
                " (contain) description
                     " (contain) "BoolFunc defines a flag with the specified name and usage string without requiring values. Each time the flag is seen, fn is called with the value of the flag. If fn returns a non-nil error, it will be treated as a flag value parsing error."
           " (contain) BoolVar
                " (contain) signature
                     " (contain) "func BoolVar(p *bool, name string, value bool, usage string)"
                " (contain) description
                     " (contain) "BoolVar defines a bool flag with specified name, default value, and usage string. The argument p points to a bool variable in which to store the value of the flag."
           " (contain) Duration
                " (contain) signature
                     " (contain) "func Duration(name string, value time.Duration, usage string) *time.Duration"
                " (contain) description
                     " (contain) "Duration defines a time.Duration flag with specified name, default value, and usage string. The return value is the address of a time.Duration variable that stores the value of the flag. The flag accepts a value acceptable to time.ParseDuration."
           " (contain) DurationVar
                " (contain) signature
                     " (contain) "func DurationVar(p *time.Duration, name string, value time.Duration, usage string)"
                " (contain) description
                     " (contain) "DurationVar defines a time.Duration flag with specified name, default value, and usage string. The argument p points to a time.Duration variable in which to store the value of the flag. The flag accepts a value acceptable to time.ParseDuration."
