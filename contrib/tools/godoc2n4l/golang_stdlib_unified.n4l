 testing
      " (source) import-path: testing
      " (description) "Package testing provides support for automated testing of Go packages. It is intended to be used in concert with the 'go test' command, which automates execution of any function of the form"
@sep1 Functions in testing
      AllocsPerRun
           " (def) "func AllocsPerRun(runs int, f func()) (avg float64)"
      CoverMode
           " (def) "func CoverMode() string"
      Coverage
           " (def) "func Coverage() float64"
           " (description) Coverage reports the current code coverage as a fraction in the range [0, 1]. If coverage is not enabled, Coverage returns 0.
      Init
           " (def) "func Init()"
      Main
           " (def) "func Main(matchString func(pat, str string) (bool, error), tests []InternalTest, benchmarks []InternalBenchmark, examples []InternalExample)"
      RegisterCover
           " (def) "func RegisterCover(c Cover)"
      RunBenchmarks
           " (def) "func RunBenchmarks(matchString func(pat, str string) (bool, error), benchmarks []InternalBenchmark)"
           " (description) "RunBenchmarks is an internal function but exported because it is cross-package; it is part of the implementation of the 'go test' command."
      RunExamples
           " (def) "func RunExamples(matchString func(pat, str string) (bool, error), examples []InternalExample) (ok bool)"
           " (description) "RunExamples is an internal function but exported because it is cross-package; it is part of the implementation of the 'go test' command."
      RunTests
           " (def) "func RunTests(matchString func(pat, str string) (bool, error), tests []InternalTest) (ok bool)"
           " (description) "RunTests is an internal function but exported because it is cross-package; it is part of the implementation of the 'go test' command."
      Short
           " (def) "func Short() bool"
           " (description) Short reports whether the -test.short flag is set.
      Testing
           " (def) "func Testing() bool"
      Verbose
           " (def) "func Verbose() bool"
           " (description) Verbose reports whether the -test.v flag is set.
@sep2 Types in testing
      B
           " (description) struct
