           " (description) Min returns the smaller of x or y.
      Mod
           " (def) "func Mod(x, y float64) float64"
           " (description) Mod returns the floating-point remainder of x/y. The magnitude of the result is less than y and its sign agrees with that of x.
      Modf
           " (def) "func Modf(f float64) (int float64, frac float64)"
           " (description) Modf returns integer and fractional floating-point numbers that sum to f. Both values have the same sign as f.
      NaN
           " (def) "func NaN() float64"
           " (description) NaN returns an IEEE 754 “not-a-number” value.
      Nextafter
           " (def) "func Nextafter(x, y float64) (r float64)"
           " (description) Nextafter returns the next representable float64 value after x towards y.
      Nextafter32
           " (def) "func Nextafter32(x, y float32) (r float32)"
           " (description) Nextafter32 returns the next representable float32 value after x towards y.
      Pow
           " (def) "func Pow(x, y float64) float64"
           " (description) "Pow returns x y, the base-x exponential of y."
      Pow10
           " (def) "func Pow10(n int) float64"
           " (description) "Pow10 returns 10 n, the base-10 exponential of n."
      Remainder
           " (def) "func Remainder(x, y float64) float64"
           " (description) Remainder returns the IEEE 754 floating-point remainder of x/y.
      Round
           " (def) "func Round(x float64) float64"
           " (description) Round returns the nearest integer, rounding half away from zero.
      RoundToEven
           " (def) "func RoundToEven(x float64) float64"
           " (description) RoundToEven returns the nearest integer, rounding ties to even.
      Signbit
           " (def) "func Signbit(x float64) bool"
           " (description) Signbit reports whether x is negative or negative zero.
      Sin
           " (def) "func Sin(x float64) float64"
           " (description) Sin returns the sine of the radian argument x.
      Sincos
           " (def) "func Sincos(x float64) (sin, cos float64)"
           " (description) "Sincos returns Sin(x), Cos(x)."
      Sinh
           " (def) "func Sinh(x float64) float64"
           " (description) Sinh returns the hyperbolic sine of x.
      Sqrt
           " (def) "func Sqrt(x float64) float64"
           " (description) Sqrt returns the square root of x.
      Tan
           " (def) "func Tan(x float64) float64"
           " (description) Tan returns the tangent of the radian argument x.
      Tanh
           " (def) "func Tanh(x float64) float64"
           " (description) Tanh returns the hyperbolic tangent of x.
      Trunc
           " (def) "func Trunc(x float64) float64"
           " (description) Trunc returns the integer value of x.
      Y0
           " (def) "func Y0(x float64) float64"
