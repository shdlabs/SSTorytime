           " (def) "func Grow[S ~[]E, E any](s S, n int) S"
      Index
           " (def) "func Index[S ~[]E, E comparable](s S, v E) int"
           " (description) Index returns the index of the first occurrence of v in s, or -1 if not present.
      IndexFunc
           " (def) "func IndexFunc[S ~[]E, E any](s S, f func(E) bool) int"
           " (description) "IndexFunc returns the first index i satisfying f(s[i]), or -1 if none do."
      Insert
           " (def) "func Insert[S ~[]E, E any](s S, i int, v ...E) S"
