 slices
      " (source) import-path: slices
      " (description) Package slices defines various functions useful with slices of any type.
@sep1 Functions in slices
      All
           " (def) "func All[Slice ~[]E, E any](s Slice) iter.Seq2[int, E]"
           " (description) All returns an iterator over index-value pairs in the slice in the usual order.
      AppendSeq
           " (def) "func AppendSeq[Slice ~[]E, E any](s Slice, seq iter.Seq[E]) Slice"
           " (description) AppendSeq appends the values from seq to the slice and returns the extended slice. If seq is empty, the result preserves the nilness of s.
      Backward
           " (def) "func Backward[Slice ~[]E, E any](s Slice) iter.Seq2[int, E]"
           " (description) Backward returns an iterator over index-value pairs in the slice, traversing it backward with descending indices.
      BinarySearch
           " (def) "func BinarySearch[S ~[]E, E cmp.Ordered](x S, target E) (int, bool)"
      BinarySearchFunc
           " (def) "func BinarySearchFunc[S ~[]E, E, T any](x S, target T, cmp func(E, T) int) (int, bool)"
      Chunk
           " (def) "func Chunk[Slice ~[]E, E any](s Slice, n int) iter.Seq[Slice]"
      Clip
           " (def) "func Clip[S ~[]E, E any](s S) S"
           " (description) "Clip removes unused capacity from the slice, returning s[:len(s):len(s)]. The result preserves the nilness of s."
      Clone
           " (def) "func Clone[S ~[]E, E any](s S) S"
      Collect
           " (def) "func Collect[E any](seq iter.Seq[E]) []E"
           " (description) Collect collects values from seq into a new slice and returns it. If seq is empty, the result is nil.
      Compact
           " (def) "func Compact[S ~[]E, E comparable](s S) S"
      CompactFunc
           " (def) "func CompactFunc[S ~[]E, E any](s S, eq func(E, E) bool) S"
