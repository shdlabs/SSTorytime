           " (def) "func Compare[S ~[]E, E cmp.Ordered](s1, s2 S) int"
      CompareFunc
           " (def) "func CompareFunc[S1 ~[]E1, S2 ~[]E2, E1, E2 any](s1 S1, s2 S2, cmp func(E1, E2) int) int"
      Concat
           " (def) "func Concat[S ~[]E, E any](slices ...S) S"
           " (description) Concat returns a new slice concatenating the passed in slices. If the concatenation is empty, the result is nil.
      Contains
           " (def) "func Contains[S ~[]E, E comparable](s S, v E) bool"
           " (description) Contains reports whether v is present in s.
      ContainsFunc
           " (def) "func ContainsFunc[S ~[]E, E any](s S, f func(E) bool) bool"
           " (description) "ContainsFunc reports whether at least one element e of s satisfies f(e)."
      Delete
           " (def) "func Delete[S ~[]E, E any](s S, i, j int) S"
      DeleteFunc
           " (def) "func DeleteFunc[S ~[]E, E any](s S, del func(E) bool) S"
