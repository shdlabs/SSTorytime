- Semantic Style Example

# Converted from JSON to N4L
# Using semantic arrows from SSTconfig CN-2

# JSON Object: example_semantic (2 keys)
 example_semantic
      " (contain) user
 # JSON Object: user (5 keys)
 user
      " (contain) id
           " (propt) 12345
      " (contain) name
           " (propt) "Alice Johnson"
      " (contain) email
           " (propt) alice@example.com
      " (contain) active
           " (propt) true
      " (contain) profile
  # JSON Object: profile (3 keys)
 profile
      " (contain) bio
           " (propt) "Software engineer passionate about semantic knowledge graphs"
      " (contain) location
           " (propt) "San Francisco"
      " (contain) skills
   # JSON Array: skills [3 items]
 skills
      " (setof) collection
      " (contain) "skills[0]"
           " (propt) Go
 "skills[0]"
      " (in-set) skills
      " (contain) "skills[1]"
           " (propt) Python
 "skills[1]"
      " (in-set) skills
      " (contain) "skills[2]"
           " (propt) N4L
 "skills[2]"
      " (in-set) skills



      " (contain) api
 # JSON Object: api (2 keys)
 api
      " (contain) version
           " (propt) 2.0
      " (contain) endpoints
  # JSON Array: endpoints [3 items]
 endpoints
      " (setof) collection
      " (contain) "endpoints[0]"
           " (propt) /users
 "endpoints[0]"
      " (in-set) endpoints
      " (contain) "endpoints[1]"
           " (propt) /posts
 "endpoints[1]"
      " (in-set) endpoints
      " (contain) "endpoints[2]"
           " (propt) /comments
 "endpoints[2]"
      " (in-set) endpoints



