          },
          "Arr": 0,
          "STindex": 0,
          "Line": 25,
          "Name": "Substuting from Kepler's law \\[ I\\dot\\omega_E +  \\frac{1}{2}\\mu R\\omega_M \\frac{dR}{dt}  = 0 \\]",
          "Chp": "Moon tidal effect",
          "Ctx": "calculation",
          "XYZ": {
            "X": 0,
            "Y": 0,
            "Z": 0.23076923076923084,
            "R": 0,
            "Lat": 0,
            "Lon": 0
          }
        }
